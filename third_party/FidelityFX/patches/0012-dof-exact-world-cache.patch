+// Exact whole-world input comparison; the five original passes are untouched.
+#define FFX_DOF_BIND_CB_DOF 0
+#define FFX_DOF_BIND_SRV_INPUT_COLOR 0
+#define FFX_DOF_BIND_SRV_INPUT_DEPTH 1
+
+#include "dof/ffx_dof_callbacks_hlsl.h"
+#include "dof/ffx_dof_world_cache.h"
+
+FFX_PREFER_WAVE64
+[numthreads(8, 8, 1)]
+FFX_DOF_EMBED_ROOTSIG_CONTENT
+void CS(uint3 dtID : SV_DispatchThreadID, uint3 gid : SV_GroupID, uint gix : SV_GroupIndex)
+{
+    // Uniform clear mode returns before comparison loads or group barriers.
+    // The host schedules exactly one group, outside native predication.
+    if (reuse.y != 0u)
+    {
+        if (gix == 0u)
+        {
+            rw_world_dirty[0] = 0u;
+            rw_world_dirty[1] = 0u;
+        }
+        return;
+    }
+    FfxDofCompareWorld(dtID.xy, gid.xy, gix);
+}
