+// Exact whole-world input comparison. Original DOF shaders remain unchanged.
+#ifndef FFX_DOF_WORLD_CACHE_H
+#define FFX_DOF_WORLD_CACHE_H
+
+#include "ffx_core.h"
+
+// Bind actual native inputs directly: the callbacks' virtual-coordinate helpers
+// shift their coordinates, whereas this dispatch already uses native texels.
+RWTexture2D<FfxFloat32x4> rw_world_history_color : register(u0);
+RWTexture2D<FfxUInt32> rw_world_history_depth : register(u1);
+RWTexture2D<FfxUInt32> rw_world_previous_unsafe : register(u2);
+RWStructuredBuffer<FfxUInt32> rw_world_dirty : register(u3);
+
+groupshared FfxUInt32 ffxDofWorldChanged;
+groupshared FfxUInt32 ffxDofWorldUnsafe;
+
+FfxBoolean FfxDofWorldColorUnsafe(FfxFloat32 value)
+{
+    // A typed RGBA16F history must round-trip exactly. Positive zero and finite
+    // normal half values do; conservatively reject every other representation.
+    FfxUInt32 bits = asuint(value);
+    FfxUInt32 magnitude = bits & 0x7fffffffu;
+    return bits == 0x80000000u || magnitude >= 0x7f800000u ||
+        (magnitude != 0u && magnitude < 0x38800000u);
+}
+
+FfxBoolean FfxDofWorldDepthUnsafe(FfxUInt32 bits)
+{
+    // UINT history preserves raw R32F bits. Reject exceptional inputs anyway so
+    // neither the current nor the immediately following frame can cache them.
+    FfxUInt32 magnitude = bits & 0x7fffffffu;
+    return bits == 0x80000000u || magnitude >= 0x7f800000u ||
+        (magnitude != 0u && magnitude < 0x00800000u);
+}
+
+void FfxDofCompareWorld(FfxUInt32x2 pixel, FfxUInt32x2 group, FfxUInt32 index)
+{
+    FfxBoolean validHistory = (reuse.x & 1u) != 0;
+    if (index == 0u)
+    {
+        ffxDofWorldChanged = validHistory ? 0u : 1u;
+        ffxDofWorldUnsafe = 0u;
+        // Do not inspect uninitialized histories when the host invalidates them.
+        if (validHistory)
+        {
+            if (rw_world_previous_unsafe[group] != 0u)
+                ffxDofWorldChanged = 1u;
+        }
+    }
+    GroupMemoryBarrierWithGroupSync();
+
+    FfxUInt32 width, height;
+    r_input_color.GetDimensions(width, height);
+    if (all(pixel < uint2(width, height)))
+    {
+        FfxFloat32x4 color = r_input_color.Load(int3(pixel, 0));
+        FfxUInt32 depthBits = asuint(r_input_depth.Load(int3(pixel, 0)));
+        FfxUInt32 unsafe = FfxDofWorldColorUnsafe(color.x) || FfxDofWorldColorUnsafe(color.y) ||
+            FfxDofWorldColorUnsafe(color.z) || FfxDofWorldColorUnsafe(color.w) ||
+            FfxDofWorldDepthUnsafe(depthBits);
+        FfxUInt32 changed = unsafe;
+        if (validHistory)
+        {
+            FfxFloat32x4 previous = rw_world_history_color[pixel];
+            if (any(asuint(color) != asuint(previous)) || depthBits != rw_world_history_depth[pixel])
+                changed = 1u;
+        }
+        // Every texel has one writer; no other group reads these texels.
+        rw_world_history_color[pixel] = color;
+        rw_world_history_depth[pixel] = depthBits;
+        FfxUInt32 ignored;
+        InterlockedOr(ffxDofWorldChanged, changed, ignored);
+        InterlockedOr(ffxDofWorldUnsafe, unsafe, ignored);
+    }
+    GroupMemoryBarrierWithGroupSync();
+    if (index == 0u)
+    {
+        rw_world_previous_unsafe[group] = ffxDofWorldUnsafe;
+        if (ffxDofWorldChanged != 0u)
+        {
+            FfxUInt32 ignored;
+            InterlockedOr(rw_world_dirty[0], 1u, ignored);
+        }
+        // The host clears both UINTs before dispatch. Element1 stays zero so
+        // their combined eight bytes are a valid D3D12 predication operand.
+    }
+}
+
+#endif
