+// Fixed three-entry whole-world cache. The five original DOF shaders are unchanged.
+#define FFX_DOF_BIND_CB_DOF 0
+#define FFX_DOF_BIND_SRV_INPUT_COLOR 0
+#define FFX_DOF_BIND_SRV_INPUT_DEPTH 1
+#include "dof/ffx_dof_callbacks_hlsl.h"
+#include "dof/ffx_dof_world_multi.h"
+
+[numthreads(8, 8, 1)]
+void CS(uint3 dtID : SV_DispatchThreadID, uint gix : SV_GroupIndex)
+{
+    if (reuse.y == 1u) {
+        FfxDofWorldMultiCompare(dtID.xy, gix);
+    } else if (all(dtID == 0u)) {
+        if (reuse.y == 0u) FfxDofWorldMultiInitialize();
+        else if (reuse.y == 2u) FfxDofWorldMultiSelect();
+        else if (reuse.y == 3u) FfxDofWorldMultiCommit();
+    }
+}
