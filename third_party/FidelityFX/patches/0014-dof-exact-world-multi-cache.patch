new file mode 100644
index 0000000..6893542
--- /dev/null
+++ b/sdk/include/FidelityFX/gpu/dof/ffx_dof_world_multi.h
@@ -0,0 +1,144 @@
+// GPU-owned three-entry exact world cache. No history writes during comparison.
+#ifndef FFX_DOF_WORLD_MULTI_H
+#define FFX_DOF_WORLD_MULTI_H
+#include "ffx_core.h"
+
+Texture2D<FfxFloat32x4> r_world_color0 : register(t2);
+Texture2D<FfxFloat32x4> r_world_color1 : register(t3);
+Texture2D<FfxFloat32x4> r_world_color2 : register(t4);
+Texture2D<FfxUInt32> r_world_depth0 : register(t5);
+Texture2D<FfxUInt32> r_world_depth1 : register(t6);
+Texture2D<FfxUInt32> r_world_depth2 : register(t7);
+RWStructuredBuffer<FfxUInt32> rw_world_dirty : register(u0);
+RWStructuredBuffer<FfxUInt32> rw_world_hit0 : register(u1);
+RWStructuredBuffer<FfxUInt32> rw_world_hit1 : register(u2);
+RWStructuredBuffer<FfxUInt32> rw_world_hit2 : register(u3);
+RWStructuredBuffer<FfxUInt32> rw_world_store0 : register(u4);
+RWStructuredBuffer<FfxUInt32> rw_world_store1 : register(u5);
+RWStructuredBuffer<FfxUInt32> rw_world_store2 : register(u6);
+RWStructuredBuffer<FfxUInt32> rw_world_control : register(u7);
+
+// control: valid[0..2], next FIFO[3], dirty[4..6], unsafe[7], hit[8], victim[9].
+// All seven predicates occupy distinct eight-byte resources. They are written
+// only by initialize/select, then remain immutable until every copy/dispatch ends.
+groupshared FfxUInt32 worldChanged[3];
+groupshared FfxUInt32 worldUnsafe;
+
+FfxBoolean FfxDofWorldMultiColorUnsafe(FfxFloat32 value)
+{
+    FfxUInt32 bits = asuint(value);
+    FfxUInt32 magnitude = bits & 0x7fffffffu;
+    return bits == 0x80000000u || magnitude >= 0x7f800000u ||
+        (magnitude != 0u && magnitude < 0x38800000u);
+}
+
+FfxBoolean FfxDofWorldMultiDepthUnsafe(FfxUInt32 bits)
+{
+    FfxUInt32 magnitude = bits & 0x7fffffffu;
+    return bits == 0x80000000u || magnitude >= 0x7f800000u ||
+        (magnitude != 0u && magnitude < 0x00800000u);
+}
+
+FfxFloat32x4 FfxDofWorldMultiLoadColor(FfxUInt32 slot, FfxUInt32x2 pixel)
+{
+    if (slot == 0u) return r_world_color0.Load(int3(pixel, 0));
+    if (slot == 1u) return r_world_color1.Load(int3(pixel, 0));
+    return r_world_color2.Load(int3(pixel, 0));
+}
+
+FfxUInt32 FfxDofWorldMultiLoadDepth(FfxUInt32 slot, FfxUInt32x2 pixel)
+{
+    if (slot == 0u) return r_world_depth0.Load(int3(pixel, 0));
+    if (slot == 1u) return r_world_depth1.Load(int3(pixel, 0));
+    return r_world_depth2.Load(int3(pixel, 0));
+}
+
+void FfxDofWorldMultiInitialize()
+{
+    if ((reuse.x & 1u) == 0u) {
+        rw_world_control[0] = rw_world_control[1] = rw_world_control[2] = 0u;
+        rw_world_control[3] = 0u;
+    }
+    [unroll] for (FfxUInt32 slot = 0u; slot < 3u; ++slot)
+        rw_world_control[4u + slot] = rw_world_control[slot] != 0u ? 0u : 1u;
+    rw_world_control[7] = 0u;
+    rw_world_control[8] = rw_world_control[9] = 3u;
+    [unroll] for (FfxUInt32 word = 0u; word < 2u; ++word) {
+        rw_world_dirty[word] = 0u;
+        rw_world_hit0[word] = rw_world_hit1[word] = rw_world_hit2[word] = 0u;
+        rw_world_store0[word] = rw_world_store1[word] = rw_world_store2[word] = 0u;
+    }
+}
+
+void FfxDofWorldMultiCompare(FfxUInt32x2 pixel, FfxUInt32 index)
+{
+    if (index == 0u) {
+        worldChanged[0] = worldChanged[1] = worldChanged[2] = 0u;
+        worldUnsafe = 0u;
+    }
+    GroupMemoryBarrierWithGroupSync();
+    FfxUInt32 width, height;
+    r_input_color.GetDimensions(width, height);
+    if (all(pixel < uint2(width, height))) {
+        FfxFloat32x4 color = r_input_color.Load(int3(pixel, 0));
+        FfxUInt32 depth = asuint(r_input_depth.Load(int3(pixel, 0)));
+        FfxUInt32 unsafe = FfxDofWorldMultiColorUnsafe(color.x) || FfxDofWorldMultiColorUnsafe(color.y) ||
+            FfxDofWorldMultiColorUnsafe(color.z) || FfxDofWorldMultiColorUnsafe(color.w) ||
+            FfxDofWorldMultiDepthUnsafe(depth);
+        FfxUInt32 ignored;
+        InterlockedOr(worldUnsafe, unsafe, ignored);
+        [unroll] for (FfxUInt32 slot = 0u; slot < 3u; ++slot) {
+            // Only previously committed safe entries may be read.
+            [branch] if (rw_world_control[slot] != 0u) {
+                FfxUInt32 changed = any(asuint(color) != asuint(FfxDofWorldMultiLoadColor(slot, pixel))) ||
+                    depth != FfxDofWorldMultiLoadDepth(slot, pixel);
+                InterlockedOr(worldChanged[slot], changed, ignored);
+            }
+        }
+    }
+    GroupMemoryBarrierWithGroupSync();
+    if (index == 0u) {
+        FfxUInt32 ignored;
+        [unroll] for (FfxUInt32 slot = 0u; slot < 3u; ++slot)
+            if (worldChanged[slot] != 0u) InterlockedOr(rw_world_control[4u + slot], 1u, ignored);
+        if (worldUnsafe != 0u) InterlockedOr(rw_world_control[7], 1u, ignored);
+    }
+}
+
+void FfxDofWorldMultiSelect()
+{
+    FfxUInt32 hit = 3u;
+    if (rw_world_control[7] == 0u) {
+        [unroll] for (FfxUInt32 slot = 0u; slot < 3u; ++slot)
+            if (hit == 3u && rw_world_control[4u + slot] == 0u) hit = slot;
+    }
+    rw_world_control[8] = hit;
+    rw_world_dirty[0] = hit == 3u ? 1u : 0u;
+    if (hit != 3u) {
+        if (hit == 0u) rw_world_hit0[0] = 1u;
+        else if (hit == 1u) rw_world_hit1[0] = 1u;
+        else rw_world_hit2[0] = 1u;
+    } else if (rw_world_control[7] == 0u) {
+        FfxUInt32 victim = 3u;
+        [unroll] for (FfxUInt32 slot = 0u; slot < 3u; ++slot)
+            if (victim == 3u && rw_world_control[slot] == 0u) victim = slot;
+        if (victim == 3u) victim = rw_world_control[3];
+        rw_world_control[9] = victim;
+        if (victim == 0u) rw_world_store0[0] = 1u;
+        else if (victim == 1u) rw_world_store1[0] = 1u;
+        else rw_world_store2[0] = 1u;
+        // Commit publishes this victim after all three copies are recorded.
+        rw_world_control[victim] = 0u;
+    }
+}
+
+void FfxDofWorldMultiCommit()
+{
+    FfxUInt32 victim = rw_world_control[9];
+    if (victim < 3u && rw_world_control[7] == 0u) {
+        rw_world_control[victim] = 1u;
+        rw_world_control[3] = (victim + 1u) % 3u;
+    }
+}
+
+#endif
