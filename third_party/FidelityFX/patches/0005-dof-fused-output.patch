+#if FFX_HLSL
+void FfxDofStoreNativeOutputQuad(FfxUInt32x2 coord, FfxFloat32x4 colA, FfxFloat32x4 colB, FfxFloat32x4 colC, FfxFloat32x4 colD)
+{
+	// Match four RGBA16F UAV stores followed by BLACK's native area resolve.
+	// A/B/C/D are top-left/top-right/bottom-right/bottom-left before swizzling.
+	FfxFloat32x4 a = f16tof32(f32tof16(colA));
+	FfxFloat32x4 b = f16tof32(f32tof16(colB));
+	FfxFloat32x4 c = f16tof32(f32tof16(colC));
+	FfxFloat32x4 d = f16tof32(f32tof16(colD));
+	precise FfxFloat32x4 resolved = a + b;
+	resolved = resolved + d;
+	resolved = resolved + c;
+	// The native output UAV must be RGBA32F to avoid rounding the mean again.
+	FfxDofStoreOutput(coord / 2, resolved * 0.25f);
+}
+#endif
