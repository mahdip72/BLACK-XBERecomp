 void FfxDofCombineSharpOnly(FfxUInt32x2 group, FfxUInt32x2 thread)
 {
 #if !defined(FFX_DOF_OPTION_COMBINE_IN_PLACE) || !FFX_DOF_OPTION_COMBINE_IN_PLACE
+#if FFX_HLSL
+	if (FfxDofNativeOutput2x())
+	{
+		// The original sharp path assigns scattered pixels to each lane.
+		// Instead assign the same contiguous virtual 2x2 as the blurred paths.
+		FfxUInt32x2 coord = 2 * (8 * group + thread);
+		FfxDofStoreNativeOutputQuad(coord,
+			FfxDofLoadFullInput(coord),
+			FfxDofLoadFullInput(coord + FfxUInt32x2(1, 0)),
+			FfxDofLoadFullInput(coord + FfxUInt32x2(1, 1)),
+			FfxDofLoadFullInput(coord + FfxUInt32x2(0, 1)));
+		return;
+	}
+#endif
 	FfxUInt32x2 base = 16 * group;
 	FfxDofStoreOutput(base + thread + FfxUInt32x2(0, 0), FfxDofLoadFullInput(base + thread + FfxUInt32x2(0, 0)));
 	FfxDofStoreOutput(base + thread + FfxUInt32x2(8, 0), FfxDofLoadFullInput(base + thread + FfxUInt32x2(8, 0)));
@@ -489,6 +520,13 @@ void FfxDofCombineFarOnly(FfxUInt32x2 id, FfxUInt32x2 gtID, FfxUInt32x2 gid, Ffx
