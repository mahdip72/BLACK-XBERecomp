+FfxErrorCode ffxDofContextGetReuseDiagnostics(FfxDofContext* context, FfxDofReuseDiagnostics* diagnostics)
+{
+    FFX_RETURN_ON_ERROR(context && diagnostics, FFX_ERROR_INVALID_POINTER);
+    auto* impl = reinterpret_cast<FfxDofContext_Private*>(context);
+    FFX_RETURN_ON_ERROR(impl->device, FFX_ERROR_NULL_DEVICE);
+    FFX_RETURN_ON_ERROR(impl->reuseEnabled, FFX_ERROR_INVALID_ARGUMENT);
+    FFX_RETURN_ON_ERROR(impl->contextDescription.backendInterface.fpGetResource, FFX_ERROR_INCOMPLETE_INTERFACE);
+    auto* backend = &impl->contextDescription.backendInterface;
+    diagnostics->dirtyHierarchy = backend->fpGetResource(backend, impl->srvResources[FFX_DOF_RESOURCE_IDENTIFIER_DIRTY_HIERARCHY]);
+    diagnostics->certificate = backend->fpGetResource(backend, impl->srvResources[FFX_DOF_RESOURCE_IDENTIFIER_REUSE_CERTIFICATE]);
+    diagnostics->nearColor = backend->fpGetResource(backend, impl->srvResources[FFX_DOF_RESOURCE_IDENTIFIER_INTERNAL_NEAR]);
+    diagnostics->farColor = backend->fpGetResource(backend, impl->srvResources[FFX_DOF_RESOURCE_IDENTIFIER_INTERNAL_FAR]);
+    diagnostics->groupWidth = (impl->contextDescription.resolution.width / 2 + 7) / 8;
+    diagnostics->groupHeight = (impl->contextDescription.resolution.height / 2 + 7) / 8;
+    diagnostics->hierarchyMipCount = impl->reuseHierarchyMipCount;
+    diagnostics->historyValid = impl->reuseHistoryValid;
+    return FFX_OK;
+}
