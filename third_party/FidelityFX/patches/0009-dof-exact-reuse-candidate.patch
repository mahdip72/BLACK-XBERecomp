+FfxErrorCode ffxDofContextInvalidateReuseHistory(FfxDofContext* context)
+{
+    FFX_RETURN_ON_ERROR(context, FFX_ERROR_INVALID_POINTER);
+    auto* impl = reinterpret_cast<FfxDofContext_Private*>(context);
