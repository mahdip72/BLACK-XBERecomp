diff --git a/sdk/include/FidelityFX/gpu/dof/ffx_dof_reuse.h b/sdk/include/FidelityFX/gpu/dof/ffx_dof_reuse.h
new file mode 100644
index 0000000..f0f295c
--- /dev/null
+++ b/sdk/include/FidelityFX/gpu/dof/ffx_dof_reuse.h
@@ -0,0 +1,180 @@
+// Scratch exact-world-reuse experiment. Default blur never includes this header.
+#ifndef FFX_DOF_REUSE_H
+#define FFX_DOF_REUSE_H
+
+FfxBoolean FfxDofReuseHistoryValid() { return (reuse.x & 1u) != 0; }
+FfxBoolean FfxDofReuseSkipEnabled() { return (reuse.x & 2u) != 0; }
+FfxUInt32 FfxDofReuseReduceLevel() { return reuse.y; }
+FfxUInt32 FfxDofReuseHierarchyWidth() { return reuse.z; }
+
+#if defined(FFX_DOF_REUSE_COMPARE)
+groupshared FfxUInt32 ffxDofReuseChanged;
+
+// Typed FP16 history round trips are accepted only for positive zero and normal
+// finite half values. Reject -0, half subnormals, and nonfinite representations.
+// The previous unsafe marker also rejects the first unsafe-to-safe transition.
+FfxBoolean FfxDofReuseUnsafe(FfxFloat32 value)
+{
+    FfxUInt32 bits = asuint(value);
+    FfxUInt32 magnitude = bits & 0x7fffffffu;
+    return bits == 0x80000000u || magnitude >= 0x7f800000u ||
+        (magnitude != 0u && magnitude < 0x38800000u);
+}
+
+void FfxDofCompareHistory(FfxUInt32x2 group, FfxUInt32x2 local)
+{
+    FfxBoolean leader = all(local == 0);
+    // Host requires both native-half dimensions to be multiples of eight.
+    if (any(group >= (InputSizeHalf() >> 3)))
+    {
+        if (leader)
+        {
+            rw_dirty_hierarchy[0][group] = 0;
+            rw_reuse_certificate[group] = 0;
+        }
+        return;
+    }
+    if (leader)
+    {
+        ffxDofReuseChanged = FfxDofReuseHistoryValid() ? 0u : 1u;
+        // Invalid history must not read either old hierarchy flags or certs.
+        if (FfxDofReuseHistoryValid())
+        {
+            if ((rw_dirty_hierarchy[0][group] & 0x80000000u) != 0 ||
+                rw_reuse_certificate[group] != 0)
+                ffxDofReuseChanged = 1u;
+        }
+        // Consume the prior certificate before initializing this dispatch's one.
+        rw_reuse_certificate[group] = 0;
+    }
+    GroupMemoryBarrierWithGroupSync();
+    FfxUInt32 changed = 0;
+    [unroll] for (FfxUInt32 mip = 0; mip < 4; ++mip)
+    {
+        FfxUInt32 side = 8u >> mip;
+        if (all(local < side))
+        {
+            FfxUInt32x2 texel = group * side + local;
+            FfxFloat32x4 value = r_internal_bilat_color.Load(int3(texel, mip));
+            FfxBoolean unsafe = FfxDofReuseUnsafe(value.x) || FfxDofReuseUnsafe(value.y) ||
+                FfxDofReuseUnsafe(value.z) || FfxDofReuseUnsafe(value.w);
+            if (unsafe) changed |= 0x80000001u;
+            if (FfxDofReuseHistoryValid())
+            {
+                FfxFloat32x4 previous = rw_history_bilat_color[mip][texel];
+                if (any(asuint(value) != asuint(previous))) changed |= 1u;
+            }
+            // Each history texel has exactly one writer, and no neighbor reader.
+            rw_history_bilat_color[mip][texel] = value;
+        }
+    }
+    if (all(local < 2u))
+    {
+        FfxUInt32x2 texel = group * 2u + local;
+        FfxFloat32x2 value = r_internal_dilated_radius.Load(int3(texel, 0));
+        if (FfxDofReuseUnsafe(value.x) || FfxDofReuseUnsafe(value.y)) changed |= 0x80000001u;
+        if (FfxDofReuseHistoryValid())
+        {
+            FfxFloat32x2 previous = rw_history_dilated_radius[texel];
+            if (any(asuint(value) != asuint(previous))) changed |= 1u;
+        }
+        rw_history_dilated_radius[texel] = value;
+    }
+    FfxUInt32 ignored;
+    InterlockedOr(ffxDofReuseChanged, changed, ignored);
+    GroupMemoryBarrierWithGroupSync();
+    if (leader) rw_dirty_hierarchy[0][group] = ffxDofReuseChanged;
+}
+#endif
+
+#if defined(FFX_DOF_REUSE_REDUCE)
+void FfxDofReduceDirty(FfxUInt32x2 texel)
+{
+    FfxUInt32 source = FfxDofReuseReduceLevel();
+    FfxUInt32 side = FfxDofReuseHierarchyWidth() >> (source + 1u);
+    if (any(texel >= side)) return;
+    FfxUInt32x2 p = texel * 2u;
+    rw_dirty_hierarchy[source + 1u][texel] =
+        rw_dirty_hierarchy[source][p] | rw_dirty_hierarchy[source][p + uint2(1, 0)] |
+        rw_dirty_hierarchy[source][p + uint2(0, 1)] | rw_dirty_hierarchy[source][p + uint2(1, 1)];
+}
+#endif
+
+#if defined(FFX_DOF_REUSE_BLUR)
+// The radius128 rectangle is an eligibility choice, not a recurrence bound.
+// Each actual sampled address is certified against it during full recomputation.
+void FfxDofReuseBox(FfxUInt32x2 group, out FfxInt32x2 lo, out FfxInt32x2 hi)
+{
+    lo = max(int2(group) - 16, 0);
+    hi = min(int2(group) + 16, int2(InputSizeHalf() >> 3) - 1);
+}
+
+void FfxDofReuseReject(FfxUInt32x2 group)
+{
+    FfxUInt32 ignored;
+    InterlockedOr(rw_reuse_certificate[group], 1u, ignored);
+}
+
+void FfxDofReuseCertifyBlocks(FfxUInt32x2 group, FfxInt32x2 first, FfxInt32x2 last)
+{
+    FfxInt32x2 lo, hi;
+    FfxDofReuseBox(group, lo, hi);
+    if (any(first < lo) || any(last > hi)) FfxDofReuseReject(group);
+}
+
+// D3D11.3 functional spec7.18.7 and7.18.16.1: normalized coordinate
+// scaling is followed by >=8-fraction-bit fixed-point rounding then floor.
+// With finite UV[-2,3], certificate-only saturate keeps scaled values<=16384.
+// Independent multiply error and fixed rounding are enclosed by floor(p) +/-2.
+// Clamp both ends before converting to blocks; use the actual SRV mip size.
+void FfxDofReuseCertifySample(FfxUInt32x2 group, FfxFloat32x2 uv, FfxUInt32 mip)
+{
+    if (mip > 3u || any(!isfinite(uv)) || any(uv < -2.0) || any(uv > 3.0))
+    {
+        FfxDofReuseReject(group);
+        return;
+    }
+    // Reject an out-of-contract LOD above; leave the original sampler call intact.
+    FfxUInt32 width, height, levels;
+    r_internal_bilat_color.GetDimensions(mip, width, height, levels);
+    FfxInt32x2 size = int2(width, height);
+    FfxInt32x2 center = int2(floor(saturate(uv) * float2(size)));
+    FfxInt32x2 first = clamp(center - 2, 0, size - 1);
+    FfxInt32x2 last = clamp(center + 2, 0, size - 1);
+    FfxDofReuseCertifyBlocks(group, (first << mip) >> 3, (last << mip) >> 3);
+}
+
+void FfxDofReuseCertifyFixedInputs(FfxUInt32x2 pixel)
+{
+    FfxUInt32x2 group = pixel >> 3;
+    // Integer mip0 center loads belong to the original native 8x8 block.
+    FfxDofReuseCertifyBlocks(group, int2(group), int2(group));
+    FfxUInt32 width, height;
+    r_internal_dilated_radius.GetDimensions(width, height);
+    // Exactly the same UV expression as FfxDofSampleDilatedRadius.
+    FfxFloat32x2 uv = float2(pixel) * InputSizeHalfRcp();
+    FfxInt32x2 size = int2(width, height);
+    // Linear addressing uses texel-center offset -0.5. +/-2 encloses both
+    // contributors after multiply/fixed-point error. One block owns2x2 tiles.
+    FfxInt32x2 center = int2(floor(saturate(uv) * float2(size) - 0.5));
+    FfxInt32x2 first = clamp(center - 2, 0, size - 1);
+    FfxInt32x2 last = clamp(center + 3, 0, size - 1);
+    FfxDofReuseCertifyBlocks(group, first >> 1, last >> 1);
+}
+
+FfxBoolean FfxDofReuseCanSkip(FfxUInt32x2 group)
+{
+    if (!FfxDofReuseHistoryValid() || !FfxDofReuseSkipEnabled()) return false;
+    FfxInt32x2 lo, hi;
+    FfxDofReuseBox(group, lo, hi);
+    FfxUInt32 span = max(hi.x - lo.x + 1, hi.y - lo.y + 1);
+    FfxUInt32 level = span > 1u ? FfxUInt32(firstbithigh(span - 1u)) + 1u : 0u;
+    FfxInt32x2 a = lo >> level, b = hi >> level;
+    FfxUInt32 dirty = r_dirty_hierarchy.Load(int3(a, level)) |
+        r_dirty_hierarchy.Load(int3(int2(b.x, a.y), level)) |
+        r_dirty_hierarchy.Load(int3(int2(a.x, b.y), level)) |
+        r_dirty_hierarchy.Load(int3(b, level));
+    return (dirty & 1u) == 0;
+}
+#endif
+#endif
